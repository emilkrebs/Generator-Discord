{
    "compilerOptions": {
      "target": "ES2022",
      "module": "node16",
      "moduleResolution": "node16",
      "lib": ["ESNext"],
      "sourceMap": true,
      "outDir": "dist",
      "rootDir": ".",
      "strict": true,
      "noUnusedLocals": true,
      "noImplicitReturns": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": [
       "src/**/*.ts"
    ],
    "exclude": [
       "dist",
       "node_modules"
    ]
  }